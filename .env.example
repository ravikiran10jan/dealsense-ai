# Azure Configuration
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=dealsense-vectors

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=raw-documents

# SharePoint
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development

# Opik Observability & Evaluation
# Set OPIK_ENABLED=true to activate LLM tracing and evaluation
# To get your API key: Go to https://www.comet.com/opik and sign in (create free account if needed)
# Click on the User icon (bottom left) → API Keys → Create API Key
OPIK_ENABLED=true
OPIK_API_KEY=                  # API key for Opik Cloud (leave blank for self-hosted)
OPIK_WORKSPACE=                # Opik Cloud workspace name
OPIK_URL_OVERRIDE=             # Self-hosted Opik URL (e.g. http://localhost:5173)
OPIK_PROJECT_NAME=dealsense-ai # Project name in Opik dashboard
